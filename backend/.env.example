# ---------- Server ----------
PORT=5000
FRONTEND_URL=http://localhost:3000

# ---------- Database (PostgreSQL) ----------
# Supabase: Project Settings -> Database -> Connection string (URI).
# IMPORTANT: change postgresql:// to jdbc:postgresql://
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT.supabase.co:5432/postgres
DB_USER=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD

# ---------- Auth ----------
# Any long random string, e.g. 052f276b... (64 hex chars)
JWT_SECRET=change-me-to-a-long-random-string

# ---------- Cloudinary (images) - optional, get free keys at cloudinary.com ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Seeded owner account (matches your Figma Admin Users table) ----------
OWNER_NAME=Ontiretse B.
OWNER_EMAIL=ontiretse@biust.ac.bw
OWNER_PASSWORD=OwnerPass123!

# ---------- Email (optional - forgot password works without it) ----------
# Leave MAIL_ENABLED=false to print the reset link in the terminal instead
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESET_URL_BASE=http://localhost:3000/reset-password
