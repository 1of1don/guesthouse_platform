# Copy this file to .env and fill it in. Never commit the real .env file.

# Port the API listens on.
PORT=4000

# Firebase project id (Firebase console > Project settings > General).
FIREBASE_PROJECT_ID=your-project-id

# Service account key. Pick ONE of the two options below.
# Option 1: path to the downloaded key file (Project settings > Service accounts > Generate new private key).
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option 2: the whole key file as one line of JSON (useful on hosting platforms).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Web app addresses allowed to call this API, comma separated. Leave empty to allow all (development only).
ALLOWED_ORIGINS=http://localhost:5173
