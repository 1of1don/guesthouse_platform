{
  "expo": {
    "name": "Mi Casa Es Su Casa",
    "slug": "mi-casa-es-su-casa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "micasa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yourgroup.micasa",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mi Casa Es Su Casa uses your location to show prices in your local currency."
      }
    },
    "android": {
      "package": "com.yourgroup.micasa",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mi Casa Es Su Casa uses your location to show prices in your local currency."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}